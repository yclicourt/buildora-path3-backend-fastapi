# Backend environment. Copy to .env: FastAPI reads it, and docker
# compose reads the repository-root .env. The POSTGRES_* values MUST
# match in both places: compose creates the database with them, the
# API connects with them.
SECRET_KEY=
DEBUG=1
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Lets the browser send the httpOnly refresh cookie cross-origin
# (Angular :4200 -> API :8000). Keep 1 unless the frontend is same-origin:
CORS_ALLOW_CREDENTIALS=1
# Set 1 in production (HTTPS) so the refresh cookie is only sent over
# TLS. Must stay 0 on plain http://localhost, or the browser will not
# send the cookie at all:
REFRESH_COOKIE_SECURE=0
# Local tests only, without PostgreSQL (unset = PostgreSQL):
# DATABASE_ENGINE=sqlite
